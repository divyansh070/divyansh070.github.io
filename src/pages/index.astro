---
import BaseHead from '../components/BaseHead.astro';
const posts = Object.values(import.meta.glob('./blog/*.mdx', { eager: true }));
---
<html lang="en">
  <head>
    <BaseHead title="Interactive ML notes" description="Machine learning ideas explained with demos you can click, drag and break." />
  </head>
  <body>
    <main>
      <h1>Interactive ML notes</h1>
      <p class="sub">Machine learning ideas explained with demos you can click, drag and break.</p>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a href={p.url}>{p.frontmatter.title}</a>
            <span>{p.frontmatter.description}</span>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
